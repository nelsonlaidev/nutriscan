{
  "name": "nutriscan",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Nelson Lai <me@nelsonlai.dev> (https://github.com/nelsonlaidev/)",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip && pnpm lint:spell",
    "clean": "rm -rf .next",
    "db:check": "pnpm with-env drizzle-kit check",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:migrate": "pnpm with-env drizzle-kit migrate",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:reset": "pnpm with-env tsx src/db/reset.ts",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "pnpm with-env knip",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix --max-warnings 0 .",
    "lint:spell": "cspell .",
    "prepare": "lefthook install",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "with-env": "dotenvx run -f .env.local --"
  },
  "dependencies": {
    "@base-ui/react": "1.1.0",
    "@phosphor-icons/react": "2.1.10",
    "@t3-oss/env-nextjs": "0.13.10",
    "@tanstack/react-form": "1.27.7",
    "@yudiel/react-qr-scanner": "2.5.1",
    "better-auth": "1.4.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.1",
    "jotai": "2.16.2",
    "next": "16.1.4",
    "next-safe-action": "8.0.11",
    "next-themes": "0.4.6",
    "postgres": "3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "3.7.0",
    "shadcn": "3.7.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.52.0",
    "@nelsonlaidev/eslint-config": "3.2.0",
    "@nelsonlaidev/prettier-config": "0.1.1",
    "@nelsonlaidev/typescript-config": "1.2.0",
    "@tailwindcss/postcss": "4.1.18",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.10.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "consola": "3.4.2",
    "cspell": "9.6.4",
    "drizzle-kit": "0.31.8",
    "eslint": "9.39.2",
    "execa": "9.6.1",
    "knip": "5.82.1",
    "lefthook": "2.0.15",
    "postcss-load-config": "6.0.1",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "3.0.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  }
}
