{
  "name": "nutriscan",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Nelson Lai <me@nelsonlai.dev> (https://github.com/nelsonlaidev/)",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip && pnpm lint:spell",
    "clean": "rm -rf .next",
    "db:check": "pnpm with-env drizzle-kit check",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:migrate": "pnpm with-env drizzle-kit migrate",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:reset": "pnpm with-env tsx src/db/reset.ts",
    "db:seed": "pnpm with-env tsx src/db/seed.ts",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "dev": "next dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "pnpm with-env knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:spell": "cspell .",
    "prepare": "if [ -d .git ]; then lefthook install; fi",
    "start": "next start",
    "test:e2e": "NODE_ENV=test pnpm with-env playwright test",
    "test:e2e:inspector": "NODE_ENV=test pnpm with-env playwright test $1 --debug",
    "test:e2e:install": "NODE_ENV=test playwright install",
    "test:e2e:ui": "NODE_ENV=test pnpm with-env playwright test --ui",
    "tunnel": "cloudflared tunnel run --url http://localhost:3000 NutriScan",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "with-env": "dotenvx run -f .env.local --"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.99",
    "@aws-sdk/client-s3": "3.990.0",
    "@base-ui/react": "1.1.0",
    "@date-fns/tz": "1.4.1",
    "@openrouter/ai-sdk-provider": "2.2.3",
    "@orpc/client": "1.13.9",
    "@orpc/server": "1.13.9",
    "@orpc/tanstack-query": "1.13.9",
    "@phosphor-icons/react": "2.1.10",
    "@streamdown/cjk": "1.0.2",
    "@streamdown/code": "1.0.3",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@t3-oss/env-nextjs": "0.13.10",
    "@tanstack/react-form": "1.27.7",
    "@tanstack/react-query": "5.91.3",
    "@yudiel/react-qr-scanner": "2.5.1",
    "ai": "6.0.86",
    "better-auth": "1.4.17",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.1",
    "jotai": "2.16.2",
    "katex": "0.16.33",
    "next": "16.1.4",
    "next-intl": "4.8.2",
    "next-themes": "0.4.6",
    "nuqs": "2.8.8",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.8",
    "react": "19.2.3",
    "react-device-detect": "2.2.3",
    "react-dom": "19.2.3",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "shadcn": "3.7.0",
    "sonner": "2.0.7",
    "streamdown": "2.3.0",
    "tailwind-merge": "3.4.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.3",
    "uuid": "13.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.52.0",
    "@faker-js/faker": "10.3.0",
    "@nelsonlaidev/oxfmt-config": "0.1.0",
    "@nelsonlaidev/oxlint-config": "0.1.0",
    "@nelsonlaidev/typescript-config": "1.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/react-query-devtools": "5.91.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.10.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "consola": "3.4.2",
    "cspell": "9.6.4",
    "drizzle-kit": "0.31.8",
    "execa": "9.6.1",
    "knip": "6.0.1",
    "lefthook": "2.0.15",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "oxlint-tsgolint": "0.17.1",
    "postcss-load-config": "6.0.1",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3"
}
