{
  "name": "nutriscan",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Nelson Lai <me@nelsonlai.dev> (https://github.com/nelsonlaidev/)",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "bun lint && bun typecheck && bun format:check && bun knip && bun lint:spell",
    "clean": "rm -rf .next",
    "db:check": "bun with-env drizzle-kit check",
    "db:generate": "bun with-env drizzle-kit generate",
    "db:migrate": "bun with-env drizzle-kit migrate",
    "db:push": "bun with-env drizzle-kit push",
    "db:reset": "bun with-env tsx src/db/reset.ts",
    "db:seed": "bun with-env tsx src/db/seed.ts",
    "db:studio": "bun with-env drizzle-kit studio",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip-bun",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "lint:spell": "cspell .",
    "prepare": "if [ -d .git ]; then lefthook install; fi",
    "start": "next start",
    "test:e2e": "bun with-env playwright test",
    "test:e2e:inspector": "bun with-env playwright test $1 --debug",
    "test:e2e:install": "playwright install",
    "test:e2e:ui": "bun with-env playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "tunnel": "cloudflared tunnel run --url http://localhost:3000 NutriScan",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "with-env": "bun --env-file=.env.local"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.143",
    "@aws-sdk/client-s3": "3.1019.0",
    "@base-ui/react": "1.3.0",
    "@date-fns/tz": "1.4.1",
    "@openrouter/ai-sdk-provider": "2.3.3",
    "@orpc/client": "1.13.13",
    "@orpc/server": "1.13.13",
    "@orpc/tanstack-query": "1.13.13",
    "@phosphor-icons/react": "2.1.10",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-form": "1.28.5",
    "@tanstack/react-query": "5.95.2",
    "@yudiel/react-qr-scanner": "2.5.1",
    "ai": "6.0.141",
    "better-auth": "1.5.6",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "jotai": "2.19.0",
    "katex": "0.16.44",
    "next": "16.2.1",
    "next-intl": "4.8.3",
    "next-themes": "0.4.6",
    "nuqs": "2.8.9",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.8",
    "react": "19.2.4",
    "react-device-detect": "2.2.3",
    "react-dom": "19.2.4",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "shadcn": "4.1.1",
    "sonner": "2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.3",
    "uuid": "13.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "10.3.0",
    "@nelsonlaidev/eslint-config": "4.0.0",
    "@nelsonlaidev/prettier-config": "0.2.1",
    "@nelsonlaidev/typescript-config": "1.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.2",
    "@tanstack/react-query-devtools": "5.95.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "consola": "3.4.2",
    "cspell": "9.7.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.1.0",
    "execa": "9.6.1",
    "knip": "6.0.1",
    "lefthook": "2.0.15",
    "postcss-load-config": "6.0.1",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.2",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24"
  }
}
