{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "useGitignore": true,
  "enableGlobDot": true,
  "enabledFileTypes": {
    "*": true
  },
  "ignoreRandomStrings": true,
  "allowCompoundWords": true,
  "dictionaries": ["npm", "fullstack", "html", "sql"],
  "ignorePaths": ["pnpm-lock.yaml", ".git"],
  "words": [
    "asse",
    "bradlc",
    "carb",
    "dbaeumer",
    "devtunnels",
    "dotenvx",
    "nelsonlaidev",
    "nums",
    "nutriscan",
    "sonarjs",
    "tdee",
    "unifiedjs",
    "yudiel"
  ]
}
