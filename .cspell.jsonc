{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "useGitignore": true,
  "enableGlobDot": true,
  "enabledFileTypes": {
    "*": true,
  },
  "ignoreRandomStrings": true,
  "allowCompoundWords": true,
  "dictionaries": ["npm", "fullstack", "html", "sql"],
  "ignorePaths": ["pnpm-lock.yaml", ".git", "src/db/migrations/meta/*.json"],
  "words": [
    "asse",
    "bradlc",
    "carb",
    "dbaeumer",
    "dotenvx",
    "intolerances",
    "Jeor",
    "katex",
    "kree",
    "madripoor",
    "namor",
    "nelsonlai",
    "nelsonlaidev",
    "nums",
    "nuqs",
    "nutriscan",
    "oxfmt",
    "oxlint",
    "shiki",
    "sonarjs",
    "tdee",
    "tsgolint",
    "unifiedjs",
    "yudiel",
    "zoodles",
  ],
}
